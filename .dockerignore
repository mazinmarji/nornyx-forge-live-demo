# Keep the build context small. The Dockerfile copies only pyproject.toml,
# README.md, src/, .nornyx/, and BRD.md, but the whole context is transferred
# to the daemon first, and .venv alone is ~1 GB.
.venv/
.git/
.github/
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
coverage.xml
build/
dist/
*.egg-info/
.env
.env.*
!.env.example
worktrees/
evidence/
.nornyx/runs/
.nornyx/cache/
.nornyx/runtime/
.nornyx/architecture/
.nornyx/security/
.nornyx/requirements/
.nornyx/in-session/
.nornyx/demo-data.json

# Builder-local state that is gitignored and therefore never reviewed.
# `.nornyx/generated/brd_contract.nyx` is a governance contract: it was
# shipping into the image from whatever the builder happened to have on
# disk, outside the runtime subject, so tampering with it was invisible to
# both git and the authority digest.
.nornyx/generated/
.nornyx/foundation-decision.json
.nornyx/goals.json
.nornyx/qualification.json
.nornyx/scout-results.json

# `*.egg-info/` above matches only at the root: Docker's pattern matching
# does not cross directory separators, so src/<name>.egg-info/ shipped.
**/*.egg-info/
