# No model API key is required for the default Claude Code worker mode.
# Claude Code must already be installed and authenticated.
FORGE_WORKER_MODE=claude-code
FORGE_AUTONOMOUS_DEMO=true
FORGE_MAX_REPAIR_ATTEMPTS=3
FORGE_APP_PORT=8000
FORGE_DASHBOARD_PORT=8787

# Optional GitHub token raises public API rate limits for Repo Scout.
GITHUB_TOKEN=

# Optional: use a normal CrewAI model provider instead of Claude Code workers.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
