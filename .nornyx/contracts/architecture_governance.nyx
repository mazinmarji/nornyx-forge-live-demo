nornyx: "0.2"
project:
  name: NornyxForgeArchitecture
  profile: architecture_governance
  profile_pack:
    name: architecture_governance
    version: 1.0.0
    status: candidate
  purpose: Govern the target architecture and conformance evidence of the Nornyx Forge live demonstration.

intents:
  - name: PreserveGovernedArchitecture
    goal: Keep API, orchestration, governance, evidence, and persistence boundaries explicit and testable.

contexts:
  - name: ArchitectureContext
    include: [docs/ARCHITECTURE.md, src/**/*.py, scripts/check_architecture.py]
    exclude: [.env, .venv/**, .nornyx/**, evidence/**]
    authority: [docs/ARCHITECTURE.md, .nornyx/contracts/architecture_governance.nyx]
    budget:
      max_tokens: 24000
      reserve_output_tokens: 3000

agents:
  - name: SolutionArchitect
    role: Maintain declared components, modules, layers, and dependency direction.
    policy: ArchitecturePolicy
  - name: ArchitectureInspector
    role: Produce independent architecture conformance evidence without editing implementation.
    policy: ArchitectureReviewPolicy

policies:
  - name: ArchitecturePolicy
    # `ui_direct_persistence_access` was removed from this list. It denied
    # an edge THIS CONTRACT declares -- component.api depends_on
    # component.persistence -- and no check consumed the token, so it was a
    # prohibition in the governance source of truth that governed nothing.
    # A control name with no decision point is worse than no name: it reads
    # as protection. The remaining two are enforced, and
    # tests/test_architecture_vocabulary.py holds each to a decision point.
    deny: [undeclared_component_dependency, api_direct_command_execution]
    require: [architecture_evidence_per_change, revision_binding, bounded_external_adapter]
  - name: ArchitectureReviewPolicy
    deny: [reviewer_modifies_implementation, ai_architecture_approval]
    require: [independent_conformance_check, explicit_exception_for_violation]

evidence:
  required:
    - architecture_conformance_report
    - independent_review_record
    - exception_review_record
    - change_record
    - approval_record
    - evidence_manifest

goals:
  - id: GOAL-ARCH-001
    title: Preserve the Forge architecture boundary
    phase: demo-0.2
    goal: Verify declared dependency direction and prevent direct execution from the API layer.
    scope: [src/, scripts/check_architecture.py, docs/ARCHITECTURE.md]
    non_goals: [production_deployment_approval, mandatory_runtime_attestation]
    validation:
      - python scripts/check_architecture.py
      - nornyx check .nornyx/contracts/architecture_governance.nyx
    evidence: .nornyx/architecture/
    approval: autonomous demonstration conformance only; human architecture approval is not granted
    stop_rules: [stop_on_unresolved_boundary_violation, stop_on_policy_weakening]

approvals:
  - name: ArchitectureAuthority
    # A signer states the role they acted in, and the contract must accept that
    # role without ambiguity. Requiring `architect` while listing
    # `architecture_reviewer` as eligible left a reviewer-signed approval
    # readable two ways. The required role is now the one a reviewer signs as.
    required_roles: [architecture_reviewer]
    eligible_roles: [architect, architecture_reviewer]
    denied_actor_types: [ai_tool, execution_surface, autonomous_agent, model, connector, generated_output]
    required_evidence: [architecture_conformance_report, independent_review_record, approval_record]
    required_for: [approve_architecture, merge_architecture_change]
    timing: before_merge
    accountable_authority: architecture_owner
    revision_binding:
      kind: git
      revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      exact: true
    invalidation_conditions: [revision_change, scope_change]
    expires_at: null

governance_evidence:
  schema: nornyx.governance_evidence.v1
  subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
  records:
    - id: architecture_conformance_report
      type: architecture_evidence
      schema_id: nornyx.architecture_evidence.v1
      producer: {id: tool:check_architecture, type: tool}
      artifact: evidence/architecture_conformance_report.json
      content_hash: sha256:ad8d8cfeac3f8c4cbc8bc3aea07c9c01f0156353f8f3a9359d954f9856a136ac
      subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      tool: {name: check_architecture, version: "0.3.0"}
      generated_at: "2026-08-30T15:29:47Z"
      expires_at: "2027-08-30T15:29:47Z"
      status: pass
      dependencies: []
    - id: independent_review_record
      type: independent_review_record
      schema_id: nornyx.governance_evidence.v1
      producer: {id: tool:in_session_inspectors, type: tool}
      artifact: evidence/architecture_independent_review.json
      content_hash: sha256:8b1667c0e9d207df2c1529bc974dd8b4c2ee19570a101f77efca71b22cf88741
      subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      tool: {name: in_session_inspectors, version: "0.3.0"}
      generated_at: "2026-08-30T15:29:47Z"
      expires_at: "2027-08-30T15:29:47Z"
      status: observed
      dependencies: []
    - id: exception_review_record
      type: exception_review_record
      schema_id: nornyx.governance_evidence.v1
      producer: {id: tool:forge_gates, type: tool}
      artifact: evidence/architecture_exception_review.json
      content_hash: sha256:7d75fc92d58506043d2e9fc51424943273df44c2e65703370a57b8cdbbaf1894
      subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      tool: {name: forge_gates, version: "0.3.0"}
      generated_at: "2026-08-30T15:29:47Z"
      expires_at: "2027-08-30T15:29:47Z"
      status: pass
      dependencies: []
    - id: change_record
      type: change_record
      schema_id: nornyx.governance_evidence.v1
      producer: {id: tool:forge_gates, type: tool}
      artifact: evidence/architecture_change_record.json
      content_hash: sha256:757651c7716f278f487097afc05de874791d632f4f013ef8a65d0714fc28f9e7
      subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      tool: {name: forge_gates, version: "0.3.0"}
      generated_at: "2026-08-30T15:29:47Z"
      expires_at: "2027-08-30T15:29:47Z"
      status: pass
      dependencies: [architecture_conformance_report]
    - id: evidence_manifest
      type: evidence_manifest
      schema_id: nornyx.governance_evidence.v1
      producer: {id: tool:refresh_governance_evidence, type: tool}
      artifact: evidence/architecture_evidence_manifest.json
      content_hash: sha256:f5047c261670666660bb9e7210d4f9324adb7e2f0f8929a7b21c303f821bb8f4
      subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      tool: {name: refresh_governance_evidence, version: "0.3.0"}
      generated_at: "2026-08-30T15:29:47Z"
      expires_at: "2027-08-30T15:29:47Z"
      status: pass
      dependencies: [architecture_conformance_report, exception_review_record, change_record]

    # >>> managed:approval_record
    - id: approval_record
      type: approval_record
      schema_id: nornyx.governance_evidence.v1
      producer:
        id: system:autonomous_demonstration
        type: system
      artifact: evidence/architecture_approval_record.json
      content_hash: sha256:8d8a686bc268ee31fa27fc0f93ba3eb26200e1ff901b4a9d44af01ef242c3ec8
      subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      tool:
        name: refresh_governance_evidence
        version: 0.3.0
      generated_at: "2026-08-30T15:29:47Z"
      expires_at: "2027-08-30T15:29:47Z"
      status: observed
      dependencies: []
    # <<< managed:approval_record

changes:
  - schema: nornyx.change.v1
    id: architecture.nornyx_forge_demo
    type: governance_contract_completion
    purpose: Bind the architecture contract to the actual repository revision and supply the required conformance evidence.
    status: proposed
    transition:
      from: draft
      to: proposed
      evidence: [architecture_conformance_report, change_record]
    scope: [architecture.governance_contract, architecture.conformance_evidence]
    excluded_scope: []
    risk_tier: medium
    blast_radius: component
    reversibility: reversible
    rollback_required: false
    rollback_plan_artifact: null
    irreversible_authority: null
    impacts:
      security: none
      architecture: none
      data: none
      dependency: none
      operational: minor
    required_controls: [architecture_conformance_policy, separation_of_duties_policy]
    required_evidence: [architecture_conformance_report, change_record, independent_review_record]
    approver_roles: [architecture_reviewer]
    approval_ids: [ArchitectureAuthority]
    separation_of_duties:
      author_role: repository_maintainer
      approver_role: architecture_reviewer
      disjoint: true
    revision_binding:
      kind: git
      revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
      exact: true
      scope_hash: sha256:ab029a29f5f1e4876c22c29ae4579ce0360d30e648343ac52c5c2c4a804eb1ee
    approval_invalidated_on: [revision_change, scope_change]
    exceptions: []

separation_of_duties:
  schema: nornyx.separation_of_duties.v1
  assignments:
    - subject: architecture.nornyx_forge_demo
      risk_tier: medium
      author: human:repository_maintainer
      approvers: [human:architecture_reviewer]
      evidence_producers: [tool:check_architecture, tool:in_session_inspectors]
      require_evidence_independence: true
      release_requester: null
      final_release_approver: null
      exception_requester: null
      exception_approver: null

exceptions:
  schema: nornyx.governance_exceptions.v1
  source: project_contract
  entries: []

architecture:
  schema: nornyx.architecture.v1
  subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
  descriptions:
    - id: architecture.overview
      title: Nornyx Forge logical and security architecture
      viewpoints: [viewpoint.logical, viewpoint.security]
      artifact: docs/ARCHITECTURE.md
  viewpoints:
    - id: viewpoint.logical
      name: Logical architecture
      concerns: [components, dependency_direction]
    - id: viewpoint.security
      name: Security architecture
      concerns: [trust_boundaries, command_execution]
  systems:
    - id: system.forge
      name: Nornyx Forge
      components: [component.api, component.runtime, component.governance, component.evidence, component.persistence, component.worker_adapter, component.shared_kernel, component.governed_subject, component.nornyx_cli, component.runtime_preparation, component.subject_observation, component.subject_bootstrap, component.app_launcher, component.forge_cli, component.forge_flow, component.forge_authoring, component.forge_probes, component.reviewer_trust, component.project_capsule, component.capsule_store, component.experience, component.experience_build, component.provider_contract, component.providers, component.codex_worker, component.governance_rendering, component.forge_onboarding, component.experience_sharing, component.brd_authoring]
  components:
    - id: component.api
      name: FastAPI and dashboard boundary
      system: system.forge
      layer: layer.interface
      bounded_context: context.operations
      canonical: true
      modules: [module.api]
      depends_on: [component.runtime, component.persistence]
    - id: component.runtime
      name: CrewAI Flow orchestration
      system: system.forge
      layer: layer.application
      bounded_context: context.operations
      canonical: true
      modules: [module.runtime]
      depends_on: [component.governance, component.evidence, component.worker_adapter]
    - id: component.governance
      name: Nornyx authorization and contracts
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.governance]
      depends_on: []
    # Its own component, not a corner of component.governance. A reviewer key
    # says "I inspected this content"; an approver key says "this effect may be
    # released". Modelling them as one component would make it structurally
    # unremarkable for a single key to do both, which is precisely the confusion
    # the two stores exist to prevent.
    - id: component.reviewer_trust
      name: Reviewer identity and inspection authentication
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.reviewer_trust]
      depends_on: []
    - id: component.evidence
      name: Evidence recording and validation
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.evidence]
      depends_on: []
    - id: component.persistence
      name: Local demonstration case store
      system: system.forge
      layer: layer.infrastructure
      bounded_context: context.operations
      canonical: true
      modules: [module.persistence]
      depends_on: []
    - id: component.worker_adapter
      name: Bounded external Claude Code worker adapter
      system: system.forge
      layer: layer.adapter
      bounded_context: context.operations
      canonical: true
      modules: [module.worker_adapter]
      depends_on: [component.shared_kernel]
    - id: component.shared_kernel
      name: Dependency-free shared models and helpers
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.shared_models, module.shared_util]
      depends_on: []
    # The provider-neutral project state with a human-gated authority split.
    # Pure domain: it cannot reach a filesystem or a process, which is what
    # makes the authority line revert-provable in isolation.
    - id: component.project_capsule
      name: Provider-neutral project capsule
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.project_capsule]
      depends_on: []
    # Persisting the capsule is filesystem + git, so it is an adapter under
    # constraint.bounded_external_adapter, keeping the declared list of
    # process-starting places complete.
    - id: component.capsule_store
      name: Git-backed capsule persistence adapter
      system: system.forge
      layer: layer.adapter
      bounded_context: context.operations
      canonical: true
      modules: [module.capsule_store]
      depends_on: [component.project_capsule, component.experience]
    # The lifecycle as canonical data: stages, transitions, actor kinds and
    # evidence requirements are declarations a provider cannot renegotiate.
    # Pure domain, like the capsule it uses as substrate.
    - id: component.experience
      name: Forge Experience Contract
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.experience]
      depends_on: [component.project_capsule]
    # Translates development-flow results into experience evidence. Application
    # layer: it interprets application output; it starts nothing and never
    # imports the flow -- it reads the plain dictionary the flow returns.
    - id: component.experience_build
      name: BUILD-stage evidence translation
      system: system.forge
      layer: layer.application
      bounded_context: context.operations
      canonical: true
      modules: [module.experience_build]
      depends_on: [component.experience, component.project_capsule]
    # The provider seam: what Forge asks of an AI provider and what one may
    # answer, as data. Pure domain; adapters execute, this validates.
    - id: component.provider_contract
      name: Forge Provider Contract
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.provider_contract]
      depends_on: [component.project_capsule]
    # Adapters and the registry. The Claude path is wrapped by delegation --
    # claude_worker stays untouched at its pinned path -- and codex is refused
    # honestly until its adapter exists.
    - id: component.providers
      name: Provider adapters and registry
      system: system.forge
      layer: layer.adapter
      bounded_context: context.operations
      canonical: true
      modules: [module.providers]
      depends_on: [component.provider_contract, component.worker_adapter, component.codex_worker]
    # The Codex sibling of the Claude worker adapter: process execution only,
    # same shape, same failure conventions, so one contract wraps both.
    - id: component.codex_worker
      name: Bounded external Codex CLI worker adapter
      system: system.forge
      layer: layer.adapter
      bounded_context: context.operations
      canonical: true
      modules: [module.codex_worker]
      depends_on: [component.shared_kernel]
    # Business-language governance as a deterministic rendering of contract
    # facts, with round-trip closure guards. Pure domain: parsed mappings in,
    # strings out; the contract stays the authority and the parser refuses
    # any line the renderer's grammar cannot produce.
    - id: component.governance_rendering
      name: Deterministic governance rendering
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.governance_rendering]
      depends_on: []
    # Forge's own onboarding surface: routes that pass the capsule's
    # authority rules through unchanged and serve only the guarded rendering.
    # layer.application by the forge_cli precedent -- declared for the
    # composition it performs, not the FastAPI decorators on top; it starts
    # no process, serving it is the launcher's job.
    - id: component.forge_onboarding
      name: Forge onboarding surface
      system: system.forge
      layer: layer.application
      bounded_context: context.operations
      canonical: true
      modules: [module.onboarding_app, module.onboarding_serve]
      depends_on: [component.project_capsule, component.capsule_store, component.governance_rendering, component.subject_bootstrap, component.experience_sharing, component.brd_authoring, component.forge_flow]
    # The sharing preview: minimized by a closed field registry and closed
    # value shapes, displayed for review, never transmitted -- the module
    # has no network path and the payload records its own never-sent state.
    # Pure domain over capsule and experience vocabulary.
    - id: component.experience_sharing
      name: Experience sharing preview
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.experience_sharing]
      depends_on: [component.project_capsule, component.experience]
    # Derives a parseable BRD from the capsule's CONFIRMED region only --
    # the bridge from plain language to the build flow with the authority
    # line intact. Pure domain: mappings in, one string out.
    - id: component.brd_authoring
      name: BRD derivation from confirmed capsule state
      system: system.forge
      layer: layer.domain
      bounded_context: context.build
      canonical: true
      modules: [module.brd_authoring]
      depends_on: [component.project_capsule]
    - id: component.app_launcher
      name: Bounded application server launcher
      system: system.forge
      layer: layer.adapter
      bounded_context: context.operations
      canonical: true
      modules: [module.app_launcher]
      depends_on: []
    - id: component.governed_subject
      name: Governed subject identity
      system: system.forge
      layer: layer.domain
      bounded_context: context.governance
      canonical: true
      modules: [module.governed_subject]
      depends_on: []
    - id: component.subject_observation
      name: Filesystem observation of the governed subject
      system: system.forge
      layer: layer.adapter
      bounded_context: context.governance
      canonical: true
      modules: [module.subject_observer]
      depends_on: [component.governed_subject]
    - id: component.nornyx_cli
      name: Nornyx CLI invocation adapter
      system: system.forge
      layer: layer.adapter
      bounded_context: context.governance
      canonical: true
      modules: [module.nornyx_cli_adapter]
      depends_on: []
    - id: component.runtime_preparation
      name: Runtime contract preparation
      system: system.forge
      layer: layer.application
      bounded_context: context.governance
      canonical: true
      modules: [module.runtime_preparation]
      depends_on: [component.nornyx_cli, component.governance, component.shared_kernel]
    - id: component.subject_bootstrap
      name: Subject establishment at startup
      system: system.forge
      layer: layer.application
      bounded_context: context.governance
      canonical: true
      modules: [module.subject_bootstrap]
      depends_on: [component.subject_observation, component.governed_subject]
    - id: component.forge_cli
      name: Forge command surface
      system: system.forge
      layer: layer.application
      bounded_context: context.build
      canonical: true
      modules: [module.forge_cli]
      depends_on: [component.forge_flow, component.runtime, component.governance, component.forge_authoring, component.forge_probes, component.shared_kernel, component.capsule_store]
    - id: component.forge_flow
      name: Governed development flow
      system: system.forge
      layer: layer.application
      bounded_context: context.build
      canonical: true
      modules: [module.forge_flow]
      depends_on: [component.forge_authoring, component.forge_probes, component.evidence, component.worker_adapter, component.shared_kernel, component.providers]
    - id: component.forge_authoring
      name: BRD parsing and contract authoring
      system: system.forge
      layer: layer.domain
      bounded_context: context.build
      canonical: true
      modules: [module.requirements_model, module.contract_authoring]
      depends_on: [component.shared_kernel]
    - id: component.forge_probes
      name: Bounded probes for gates, policy, and candidate repositories
      system: system.forge
      layer: layer.adapter
      bounded_context: context.build
      canonical: true
      modules: [module.gate_runner, module.policy_adapter, module.repo_qualifier, module.repo_scout]
      depends_on: [component.shared_kernel, component.evidence]
  modules:
    - id: module.api
      name: demo_app.main
      component: component.api
      layer: layer.interface
      depends_on: [module.runtime, module.persistence]
    - id: module.runtime
      name: demo_app.agentic
      component: component.runtime
      layer: layer.application
      depends_on: [module.governance, module.evidence, module.worker_adapter, module.approval_trust, module.governed_subject, module.subject_bootstrap]
    - id: module.governance
      name: nornyx_forge.nornyx_runtime
      component: component.governance
      layer: layer.domain
      depends_on: [module.shared_models, module.shared_util, module.approval_trust, module.governed_subject]
    # Authentication for action-specific consequential approvals. Deliberately a
    # leaf: it verifies signatures against a trust store held outside this
    # repository, and depends on nothing in the application or effect layers. A
    # verifier that could reach runtime effect code, or hold a signing key, would
    # no longer be separable from the thing it authenticates.
    - id: module.approval_trust
      name: nornyx_forge.approval_trust
      component: component.governance
      layer: layer.domain
      depends_on: []
    # Verification only, and depends on nothing. It must stay separable from the
    # code it authenticates: a verifier that could reach runtime effect code, or
    # hold a signing key, would be authenticating itself. Signing lives in
    # scripts/, which the runtime image never copies.
    - id: module.reviewer_trust
      name: nornyx_forge.reviewer_trust
      component: component.reviewer_trust
      layer: layer.domain
      depends_on: []
    - id: module.evidence
      name: nornyx_forge.evidence
      component: component.evidence
      layer: layer.domain
      depends_on: [module.shared_util]
    - id: module.persistence
      name: demo_app.store
      component: component.persistence
      layer: layer.infrastructure
      depends_on: []
    # Starting the application server is process execution, so it lives in a
    # declared adapter rather than in the entrypoint. The point of
    # constraint.bounded_external_adapter is that this list is complete.
    # The authority primitive, and a leaf by construction. Enumeration, byte
    # reads and git are all somewhere else: a domain module that could reach a
    # filesystem could rediscover its own authority, which is the ambient
    # re-resolution this model exists to remove. The architecture gate fails if
    # this ever gains a dependency.
    # Process execution only. It decides nothing: not risk, not approval, not
    # whether an effect may be released. Moving the governance decision here
    # merely because the subprocess lives here would relocate exactly what the
    # layering keeps apart.
    # Sequences CLI invocations and interprets their results: application work
    # that had been living in a domain module, which is why moving the
    # subprocess to an adapter surfaced a layering violation rather than
    # resolving one.
    - id: module.runtime_preparation
      name: nornyx_forge.runtime_preparation
      component: component.runtime_preparation
      layer: layer.application
      depends_on: [module.nornyx_cli_adapter, module.governance, module.approval_trust, module.shared_models, module.shared_util]
    - id: module.nornyx_cli_adapter
      name: nornyx_forge.nornyx_cli_adapter
      component: component.nornyx_cli
      layer: layer.adapter
      depends_on: []
    - id: module.project_capsule
      name: nornyx_forge.capsule
      component: component.project_capsule
      layer: layer.domain
      depends_on: []
    - id: module.capsule_store
      name: nornyx_forge.capsule_store
      component: component.capsule_store
      layer: layer.adapter
      depends_on: [module.project_capsule, module.experience]
    - id: module.experience
      name: nornyx_forge.experience
      component: component.experience
      layer: layer.domain
      depends_on: [module.project_capsule]
    - id: module.experience_build
      name: nornyx_forge.experience_build
      component: component.experience_build
      layer: layer.application
      depends_on: [module.experience, module.project_capsule]
    - id: module.provider_contract
      name: nornyx_forge.provider_contract
      component: component.provider_contract
      layer: layer.domain
      depends_on: [module.project_capsule]
    - id: module.providers
      name: nornyx_forge.providers
      component: component.providers
      layer: layer.adapter
      depends_on: [module.provider_contract, module.project_capsule, module.worker_adapter, module.codex_worker]
    - id: module.codex_worker
      name: nornyx_forge.codex_worker
      component: component.codex_worker
      layer: layer.adapter
      depends_on: [module.shared_models]
    - id: module.governance_rendering
      name: nornyx_forge.governance_rendering
      component: component.governance_rendering
      layer: layer.domain
      depends_on: []
    - id: module.onboarding_app
      name: nornyx_forge.onboarding_app
      component: component.forge_onboarding
      layer: layer.application
      depends_on: [module.project_capsule, module.capsule_store, module.governance_rendering, module.experience_sharing, module.brd_authoring, module.forge_flow]
    - id: module.experience_sharing
      name: nornyx_forge.experience_sharing
      component: component.experience_sharing
      layer: layer.domain
      depends_on: [module.project_capsule, module.experience]
    - id: module.brd_authoring
      name: nornyx_forge.brd_authoring
      component: component.brd_authoring
      layer: layer.domain
      depends_on: [module.project_capsule]
    # Assembles the onboarding app over an EXPLICIT absolute project
    # directory (relative refused -- the FORGE_ROOT doctrine) and runs the
    # server loop in-process; the process start stays in the launcher.
    - id: module.onboarding_serve
      name: nornyx_forge.onboarding_serve
      component: component.forge_onboarding
      layer: layer.application
      depends_on: [module.onboarding_app, module.subject_bootstrap]
    - id: module.governed_subject
      name: nornyx_forge.governed_subject
      component: component.governed_subject
      layer: layer.domain
      depends_on: []
    # Reading a tree is an external observation, so it is an adapter and says
    # so, rather than hiding inside a generic governance component.
    - id: module.subject_observer
      name: nornyx_forge.subject_observer
      component: component.subject_observation
      layer: layer.adapter
      depends_on: [module.governed_subject]
    # Establishes one immutable subject at startup. The action boundary is
    # given that subject; it never discovers one, because a request that can
    # cause its own subject to be re-resolved has a say in the authority
    # judging it.
    # Depends on all three trust anchors because it is the one place that
    # resolves them. Startup reading the environment once is the property; every
    # module below it receiving already-resolved locations is the consequence.
    - id: module.subject_bootstrap
      name: nornyx_forge.subject_bootstrap
      component: component.subject_bootstrap
      layer: layer.application
      depends_on: [module.subject_observer, module.governed_subject, module.approval_trust, module.reviewer_trust, module.governance]
    - id: module.app_launcher
      name: nornyx_forge.app_launcher
      component: component.app_launcher
      layer: layer.adapter
      depends_on: []
    # The Forge command surface, and the toolchain's application layer: each
    # command body composes a sequence — parse the BRD, qualify a repository,
    # write the artifact, choose an exit code — and no other module coordinates
    # that. It is declared for what it does rather than for the Typer
    # decorators sitting on top of it.
    #
    # Calling it interface and granting it an exemption for reaching into the
    # domain and the probes was the tempting alternative. Nornyx rejects that
    # outright: layer.interface may not depend on layer.domain, and the schema
    # has no vocabulary for such an exemption. A flag honoured only by
    # scripts/check_architecture.py would have left the gate reporting pass
    # while the governance engine reported a real violation, which is the
    # divergence this work exists to remove.
    #
    # Nothing depends on this module, and the gate enforces that from the
    # console entrypoint declared in pyproject.toml, so it cannot become a hub
    # carrying a dependency between two modules that may not depend on each
    # other.
    - id: module.forge_cli
      name: nornyx_forge.cli
      component: component.forge_cli
      layer: layer.application
      depends_on: [module.governed_subject, module.forge_flow, module.runtime, module.governance, module.runtime_preparation, module.app_launcher, module.repo_qualifier, module.repo_scout, module.requirements_model, module.shared_util, module.capsule_store]
    - id: module.forge_flow
      name: nornyx_forge.development_flow
      component: component.forge_flow
      layer: layer.application
      depends_on: [module.contract_authoring, module.requirements_model, module.gate_runner, module.repo_qualifier, module.repo_scout, module.evidence, module.worker_adapter, module.shared_models, module.shared_util, module.governed_subject, module.providers]
    - id: module.requirements_model
      name: nornyx_forge.requirements
      component: component.forge_authoring
      layer: layer.domain
      depends_on: [module.shared_models, module.shared_util]
    - id: module.contract_authoring
      name: nornyx_forge.contract_generator
      component: component.forge_authoring
      layer: layer.domain
      # shared_util for write_canonical_text: a generated contract is governed
      # text, and letting the platform choose its line endings made the same
      # contract digest differently on Windows and Linux.
      depends_on: [module.requirements_model, module.shared_util]
    # The probes below start external processes or reach the network, which is
    # why they are adapters rather than domain: layer.adapter is a declared place
    # for a bounded external call, and layer.domain is not.
    - id: module.gate_runner
      name: nornyx_forge.gates
      component: component.forge_probes
      layer: layer.adapter
      depends_on: [module.shared_models]
    - id: module.policy_adapter
      name: nornyx_forge.policy
      component: component.forge_probes
      layer: layer.adapter
      depends_on: [module.evidence]
    - id: module.repo_qualifier
      name: nornyx_forge.repo_qualifier
      component: component.forge_probes
      layer: layer.adapter
      depends_on: [module.shared_models]
    - id: module.repo_scout
      name: nornyx_forge.repo_scout
      component: component.forge_probes
      layer: layer.adapter
      depends_on: [module.shared_models, module.repo_qualifier]
    - id: module.worker_adapter
      name: nornyx_forge.claude_worker
      component: component.worker_adapter
      layer: layer.adapter
      depends_on: [module.shared_models]
    - id: module.shared_models
      name: nornyx_forge.models
      component: component.shared_kernel
      layer: layer.domain
      depends_on: []
    - id: module.shared_util
      name: nornyx_forge.util
      component: component.shared_kernel
      layer: layer.domain
      depends_on: []
  layers:
    - id: layer.interface
      name: Interface
      may_depend_on: [layer.application, layer.infrastructure]
    - id: layer.application
      name: Application
      may_depend_on: [layer.domain, layer.adapter]
    - id: layer.domain
      name: Domain and governance
      may_depend_on: []
    - id: layer.adapter
      name: Bounded external adapters
      may_depend_on: [layer.domain]
    - id: layer.infrastructure
      name: Infrastructure
      may_depend_on: []
  bounded_contexts:
    - id: context.operations
      name: Customer operations
      description: Case intake, orchestration, and local persistence.
    - id: context.governance
      name: Governance and assurance
      description: Nornyx authorization, architecture, and evidence.
    - id: context.build
      name: Forge build toolchain
      description: >
        The Forge tool itself: its command surface, the governed development
        flow, BRD and contract authoring, and the probes that inspect candidate
        repositories. Modelled separately from the application it builds so that
        a dependency running from the toolchain into the governed application is
        visible as a declared edge rather than an unexamined one.
  interfaces: []
  boundaries:
    trust: []
    data: []
    deployment: []
  decisions: []
  principles:
    - id: principle.explicit_side_effects
      statement: Consequential actions cross one explicit Nornyx authorization boundary.
    - id: principle.independent_checks
      statement: Deterministic architecture checks are separate from builder reasoning.
  constraints:
    - id: constraint.api_no_commands
      statement: The API layer cannot invoke shell commands directly. Decided over the declared, statically visible structure -- the check reads source and never imports governed code, so a module object reached through an expression whose value is known only at runtime is outside this constraint. See docs/ASSURANCE_BOUNDARY.md
      verified_by: architecture-check
    - id: constraint.persistence_isolation
      statement: Persistence does not depend on FastAPI, CrewAI, or subprocess execution. Decided over the declared, statically visible structure -- the check reads source and never imports governed code, so a module object reached through an expression whose value is known only at runtime is outside this constraint. See docs/ASSURANCE_BOUNDARY.md
      verified_by: architecture-check
    - id: constraint.declared_dependencies_only
      statement: Every first-party import of a declared module must appear in that module's declared depends_on. Decided over the declared, statically visible structure -- the check reads source and never imports governed code, so a module object reached through an expression whose value is known only at runtime is outside this constraint. See docs/ASSURANCE_BOUNDARY.md
      verified_by: architecture-check
    - id: constraint.layer_direction
      statement: A module may only depend on modules whose layer is permitted by its own layer's may_depend_on. Decided over the declared, statically visible structure -- the check reads source and never imports governed code, so a module object reached through an expression whose value is known only at runtime is outside this constraint. See docs/ASSURANCE_BOUNDARY.md
      verified_by: architecture-check
    - id: constraint.bounded_external_adapter
      statement: Interface and application modules never execute processes directly; they delegate to the governance module or a declared infrastructure adapter. Decided over the declared, statically visible structure -- the check reads source and never imports governed code, so a module object reached through an expression whose value is known only at runtime is outside this constraint. See docs/ASSURANCE_BOUNDARY.md
      verified_by: architecture-check
  required_checks:
    - id: architecture-check
      # STATIC AND SIDE-EFFECT-FREE, and the scope is stated rather than
      # implied. This check reads source; it never imports governed code.
      # It verifies the DECLARED, STATICALLY VISIBLE dependency structure
      # and refuses the dynamic module-acquisition constructs it can name.
      # A module object reached through an expression whose value is known
      # only at runtime is outside its scope, and outside what the
      # constraints above claim. Disclosed in docs/ASSURANCE_BOUNDARY.md
      # and enumerated in docs/governance/MODULE_ACQUISITION.md.
      tool: scripts/check_architecture.py
      evidence_schema: nornyx.architecture_evidence.v1
      frequency: per_change
      required: true
  architecture_exceptions: []

architecture_evidence:
  - schema: nornyx.architecture_evidence.v1
    check_id: architecture-check
    tool: scripts/check_architecture.py
    tool_version: "0.3.0"
    status: pass
    subject_revision: git:10b4cc2c0c4c9e12fa8e9d5e34d0caad987a260e
    generated_at: "2026-08-30T15:29:47Z"
    expires_at: "2027-08-30T15:29:47Z"
    violations: []
    artifact: evidence/architecture_conformance_report.json
    artifact_sha256: sha256:ad8d8cfeac3f8c4cbc8bc3aea07c9c01f0156353f8f3a9359d954f9856a136ac
