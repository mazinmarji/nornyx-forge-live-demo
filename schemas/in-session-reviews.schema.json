{
  "$id": "https://github.com/mazinmarji/nornyx-forge-live-demo/schemas/in-session-reviews.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "In-session findings recorded by the builder. NOT independent inspection: these are self-reported, carry no authenticated reviewer identity, and no control derives assurance from them. The previous title said 'independent review evidence', which the markdown sweeps could not see because they scan .md only.",
  "properties": {
    "builder_self_approval": {
      "const": false
    },
    "human_review": {
      "const": "not_performed"
    },
    "reviews": {
      "items": {
        "additionalProperties": true,
        "properties": {
          "evidence": {
            "type": "array"
          },
          "findings": {
            "type": "array"
          },
          "role": {
            "enum": [
              "test-inspector",
              "architecture-inspector",
              "security-inspector"
            ]
          },
          "status": {
            "enum": [
              "pass",
              "fail"
            ]
          },
          "summary": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "status",
          "findings"
        ],
        "type": "object"
      },
      "minItems": 3,
      "type": "array"
    },
    "schema": {
      "const": "nornyx.forge.in_session_reviews.v1"
    }
  },
  "required": [
    "schema",
    "human_review",
    "builder_self_approval",
    "reviews"
  ],
  "title": "Nornyx Forge in-session SELF-REPORTED review evidence",
  "type": "object"
}
